{
  "hosting": {
    "site": "bloomy-pot",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [
      {
        "comment": "version.json, index.html and sw.js must never be cached. A stale version.json/index.html would hide a new build from a long-open tab; a stale sw.js would pin an old service worker (Firebase Hosting's default 1h cache would otherwise delay every SW update by up to an hour).",
        "source": "/@(version.json|index.html|sw.js)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache, max-age=0" }]
      },
      {
        "comment": "Hashed build assets are content-addressed, so they can be cached forever.",
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "*.log", "lib/**/*.map"],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ]
}
