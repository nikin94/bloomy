rules_version = '2';

// Firestore security rules — the real server-side boundary for multi-tenancy.
// Every order/customer is scoped to its owner (the signed-in user's uid), and a
// user may only touch documents whose ownerId matches their own uid. Client-side
// owner checks (e.g. fetchOrder re-checking ownerId) are defense-in-depth; these
// rules are what actually enforce isolation. Tested in src/test/firestore.rules.test.ts.
service cloud.firestore {
  match /databases/{database}/documents {
    // True when the request is authenticated and acting as the given owner.
    function isOwner(ownerId) {
      return request.auth != null && request.auth.uid == ownerId;
    }

    // Orders: readable/deletable by their owner; creatable/updatable only with
    // the owner's own ownerId, so a user cannot plant data under another owner.
    match /orders/{orderId} {
      allow read, delete: if isOwner(resource.data.ownerId);
      allow create: if isOwner(request.resource.data.ownerId);
      allow update: if isOwner(resource.data.ownerId) && isOwner(request.resource.data.ownerId);
    }

    // Customers: same owner-scoped policy as orders.
    match /customers/{customerId} {
      allow read, delete: if isOwner(resource.data.ownerId);
      allow create: if isOwner(request.resource.data.ownerId);
      allow update: if isOwner(resource.data.ownerId) && isOwner(request.resource.data.ownerId);
    }

    // Per-owner order-number counters keyed by ownerId. The createOrder
    // transaction reads and bumps counters/{ownerId}; only that owner may.
    match /counters/{ownerId} {
      allow read, write: if isOwner(ownerId);
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
