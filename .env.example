# Firebase config. Copy this file to .env and fill in the values from the
# Firebase console (Project settings → General → Your apps → SDK setup and configuration).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Sentry error monitoring (optional). The DSN is a public, embeddable value
# (Sentry → Project settings → Client Keys (DSN)). Leave blank to disable Sentry;
# it's also skipped automatically in dev/test builds.
VITE_SENTRY_DSN=

# Source-map upload to Sentry (optional, build-time only — NOT VITE_-prefixed so
# it never reaches the client bundle). Without a token, builds still work and
# Sentry reports minified stack traces; set all three to get readable code in the
# dashboard. The token comes from Sentry → Settings → Auth Tokens.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
